{
  "name": "job-search-dashboard",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:ui\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:ui": "vite",
    "build": "tsc -p tsconfig.app.json --noEmit && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "check": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.server.json --noEmit"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.4",
    "typescript": "5.8.3",
    "vite": "^6.3.5"
  }
}
